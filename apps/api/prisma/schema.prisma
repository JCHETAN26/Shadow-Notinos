generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

/// A customer account. BYOK: each tenant supplies its own Notion/Anthropic/GitHub
/// credentials and owns its own runs, docs, and connected repos.
model Tenant {
  id         String   @id @default(uuid())
  name       String
  createdAt  DateTime @default(now())

  users      User[]
  credential TenantCredential?
  repos      RepoConnection[]

  @@map("tenants")
}

model User {
  id        String   @id @default(uuid())
  tenantId  String
  email     String   @unique
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("users")
}

/// Per-tenant secrets + config. The three *Enc fields are AES-256-GCM ciphertext
/// (see services/crypto.ts) — never store these in plaintext.
model TenantCredential {
  id                  String   @id @default(uuid())
  tenantId            String   @unique
  notionApiKeyEnc     String?
  anthropicApiKeyEnc  String?
  githubTokenEnc      String?
  githubWebhookSecret String?
  notionParentPageId  String?
  releaseBranch       String   @default("main")
  docTriggerPaths     String?
  updatedAt           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_credentials")
}

/// Maps a GitHub repo to the tenant that owns it, so an incoming webhook can be
/// routed (and its signature verified) against the right tenant.
model RepoConnection {
  id           String   @id @default(uuid())
  tenantId     String
  repoFullName String   @unique
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("repo_connections")
}

enum AgentRunStatus {
  queued
  fetching_pr
  indexing
  searching
  planning
  waiting_approval
  applying
  applied
  rejected
  no_changes
  failed
}

enum PatchPlanStatus {
  proposed
  approved
  rejected
  applied
  failed
  graduated
  dismissed
}

enum PatchActionStatus {
  pending
  applied
  failed
  skipped
}

model AgentRun {
  id            String         @id @default(uuid())
  repo          String
  prNumber      Int
  prTitle       String
  prUrl         String
  author        String?
  baseBranch    String?
  headBranch    String?
  status        AgentRunStatus @default(queued)
  diffSummary   String?
  impactSummary String?
  prContext     Json?
  relatedDocs   Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  patchPlans PatchPlan[]
  events     RunEvent[]

  @@index([repo, prNumber])
  @@map("agent_runs")
}

model RunEvent {
  id         String   @id @default(uuid())
  agentRunId String
  type       String
  message    String?
  data       Json?
  createdAt  DateTime @default(now())

  agentRun AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@index([agentRunId])
  @@map("run_events")
}

model NotionDoc {
  id            String    @id @default(uuid())
  notionPageId  String    @unique
  title         String
  serviceName   String?
  owner         String?
  docStatus     String?
  lastIndexedAt DateTime?
  updatedAt     DateTime  @updatedAt

  @@map("notion_docs")
}

/// One embedded chunk of a Notion page. `embedding` is a pgvector column managed
/// via raw SQL in the initial migration (Prisma maps it as Unsupported).
model NotionBlock {
  id           String   @id @default(uuid())
  notionPageId String
  notionBlockId String
  blockType    String
  headingPath  String?
  plainText    String
  tokenCount   Int      @default(0)
  // 384 dims — Transformers.js all-MiniLM-L6-v2 (local, offline embeddings).
  embedding    Unsupported("vector(384)")?
  updatedAt    DateTime @updatedAt

  @@index([notionPageId])
  @@map("notion_blocks")
}

model PatchPlan {
  id           String          @id @default(uuid())
  agentRunId   String
  targetPageId String
  status       PatchPlanStatus @default(proposed)
  patchJson    Json
  // Notion block ids written under the "Pending changes" toggle for a pending
  // plan. Used to promote (re-apply to body + delete) or dismiss (delete) it.
  pendingBlockIds String[]     @default([])
  createdAt    DateTime        @default(now())
  approvedAt   DateTime?
  appliedAt    DateTime?

  agentRun AgentRun      @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  actions  PatchAction[]

  @@index([agentRunId])
  @@map("patch_plans")
}

model PatchAction {
  id            String            @id @default(uuid())
  patchPlanId   String
  actionType    String
  targetBlockId String?
  headingMatch  String?
  notionPayload Json
  status        PatchActionStatus @default(pending)
  errorMessage  String?
  notionId      String?
  createdAt     DateTime          @default(now())
  appliedAt     DateTime?

  patchPlan PatchPlan @relation(fields: [patchPlanId], references: [id], onDelete: Cascade)

  @@index([patchPlanId])
  @@map("patch_actions")
}
